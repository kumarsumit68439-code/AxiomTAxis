# Railway variables for the bot worker
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
AXIOM_API_KEY=ax_live_xxxxxxxxxxxxxxxx
AXIOM_API_URL=https://axiom-ai-sand.vercel.app/api/v1/chat/completions
